{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "react-native": [
        "./node_modules/react-native"
      ],
      "react-native-nitro-modules": [
        "./node_modules/react-native-nitro-modules"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "src/mercury"
  ]
}