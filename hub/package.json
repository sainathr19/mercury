{
  "name": "mercury-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "deploy:registry": "tsx --env-file-if-exists=.env scripts/deploy-registry.ts",
    "claim": "tsx --env-file-if-exists=.env scripts/claim-name.ts",
    "ens:verify": "tsx --env-file-if-exists=.env scripts/verify-ens.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "registry:powers": "tsx --env-file-if-exists=.env scripts/registry-powers.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "solc": "^0.8.26",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
