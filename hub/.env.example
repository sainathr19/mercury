# Relayer key. Holds ONLY gas — never user funds. Needs a little native gas on
# every destination chain the relayer serves.
RELAYER_PRIVATE_KEY=0x...
PORT=8787
# Interface to bind. The Dockerfile sets 0.0.0.0, which is also the code
# default; a container that listens on loopback is reachable from nowhere but
# itself and fails its health check while logging a clean start.
# HOST=0.0.0.0

# Used ONLY by scripts/deploy-registry.ts and scripts/claim-name.ts, never by
# the server. Keep it out of the deployment: the running hub has no use for the
# key that owns the registry.
# DEPLOYER_PRIVATE_KEY=0x...


# ── Name sponsorship ─────────────────────────────────────────────────────────
# Pays the Ethereum gas so users can claim an ENS name without holding ETH.
# Uses RELAYER_PRIVATE_KEY above — that wallet needs Sepolia ETH.
# Leave ENS_REGISTRY unset to keep sponsorship off.
ENS_REGISTRY=0x...            # the deployed MercuryNameRegistry
ENS_PARENT=mercurywallet.eth
# ENS_NETWORK=mainnet         # sepolia unless this says mainnet
# ENS_RPC_URL=https://...
SPONSOR_PER_ADDRESS=1         # sponsored names per wallet
SPONSOR_PER_DAY=200           # ceiling across everyone; gas is real money
# NOT data/sponsored.json — that is the old ops-counting file, whose shape
# ({byAddress: {addr: [names]}, today: n}) has no totalWei/spentWei. Budget
# parses it without complaint and then throws `Cannot convert undefined to a
# BigInt` on the first status() or reserve() of a day whose date matches.
SPONSOR_LEDGER=data/sponsor-budget.json

# ── Spend budgets ────────────────────────────────────────────────────────────
# Denominated in ETH, not operations: counting operations does not bound cost,
# because gas price is not in the count. Both endpoints refuse above the gas
# ceiling rather than paying whatever the market asks.
SPONSOR_PER_ADDRESS_ETH=0.001
SPONSOR_PER_DAY_ETH=0.1
SPONSOR_PER_ADDRESS_OPS=1
SPONSOR_MAX_GAS_GWEI=50
# The relay is a repeated service for the same person, so its per-address
# allowance is larger — but it is global-only until the depositor can be read
# out of the attestation (see relay.ts).
RELAY_PER_DAY_ETH=0.1
RELAY_MAX_GAS_GWEI=50
RELAY_LEDGER=data/relay-budget.json
# Read by policyFromEnv but INERT today: relay.ts calls budget.reserve(null, …)
# because the depositor cannot yet be read out of Circle's attestation, so only
# the daily ceiling and the gas-price refusal actually bind. Setting these
# changes nothing until that decode lands.
# RELAY_PER_ADDRESS_ETH=0.001
# RELAY_PER_ADDRESS_OPS=50

# ── RPC endpoints ────────────────────────────────────────────────────────────
# `RPC_<chainId>` overrides the public endpoint viem ships for that chain.
# Unset keeps the default, which is fine from a laptop and frequently is NOT
# from a server: providers rate-limit datacenter IPs, and a chain the relayer
# cannot read is a chain it cannot deliver to. Check with
# `GET /gateway/domains?environment=testnet` — a `ready: null` is an unreachable
# RPC, not an unfunded wallet.
# RPC_11155111=https://eth-sepolia.g.alchemy.com/v2/<key>   # Sepolia
# RPC_421614=https://...                                    # Arbitrum Sepolia
# RPC_84532=https://...                                     # Base Sepolia
# RPC_5042002=https://rpc.testnet.arc.io                    # Arc Testnet

# ── Index proxy ──────────────────────────────────────────────────────────────
# The Graph credentials live HERE, never in the app. EXPO_PUBLIC_* is inlined
# into the bundle at build time and recoverable from the package, so a key there
# is handed to anyone who downloads the app and billed to you.
TOKEN_API_JWT=eyJ...
ARC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/.../...
