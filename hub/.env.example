# Relayer key. Holds ONLY gas — never user funds. Needs a little native gas on
# every destination chain the relayer serves.
RELAYER_PRIVATE_KEY=0x...
PORT=8787

# ── Offchain ENS subnames ────────────────────────────────────────────────────
# The key that signs gateway answers. This key decides where names point, so it
# is as sensitive as the resolver's owner — but it holds no funds and needs no
# gas. Whitelist its address on the resolver with setSigner().
ENS_SIGNER_PRIVATE_KEY=0x...
# The deployed MercuryOffchainResolver. Requests naming any other resolver are
# refused rather than signed.
ENS_RESOLVER_ADDRESS=0x...
ENS_PARENT=mercurywallet.eth
# What mercurywallet.eth itself resolves to. Without it the apex goes dark once
# this resolver is set on it.
ENS_APEX_ADDRESS=0x...
NAMES_FILE=data/names.json

# ── verify-ens.ts only ───────────────────────────────────────────────────────
# Sepolia unless this says "mainnet". ENS_RPC_URL overrides the default endpoint.
# ENS_NETWORK=mainnet
# ENS_RPC_URL=https://…
