# Relayer key. Holds ONLY gas — never user funds. Needs a little native gas on
# every destination chain the relayer serves.
RELAYER_PRIVATE_KEY=0x...
PORT=8787


# ── Name sponsorship ─────────────────────────────────────────────────────────
# Pays the Ethereum gas so users can claim an ENS name without holding ETH.
# Uses RELAYER_PRIVATE_KEY above — that wallet needs Sepolia ETH.
# Leave ENS_REGISTRY unset to keep sponsorship off.
ENS_REGISTRY=0x...            # the deployed MercuryNameRegistry
ENS_PARENT=mercurywallet.eth
# ENS_NETWORK=mainnet         # sepolia unless this says mainnet
# ENS_RPC_URL=https://...
SPONSOR_PER_ADDRESS=1         # sponsored names per wallet
SPONSOR_PER_DAY=200           # ceiling across everyone; gas is real money
SPONSOR_LEDGER=data/sponsored.json
