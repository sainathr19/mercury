# Relayer key. Holds ONLY gas — never user funds. Needs a little native gas on
# every destination chain the relayer serves.
RELAYER_PRIVATE_KEY=0x...
PORT=8787


# ── Name sponsorship ─────────────────────────────────────────────────────────
# Pays the Ethereum gas so users can claim an ENS name without holding ETH.
# Uses RELAYER_PRIVATE_KEY above — that wallet needs Sepolia ETH.
# Leave ENS_REGISTRY unset to keep sponsorship off.
ENS_REGISTRY=0x...            # the deployed MercuryNameRegistry
ENS_PARENT=mercurywallet.eth
# ENS_NETWORK=mainnet         # sepolia unless this says mainnet
# ENS_RPC_URL=https://...
SPONSOR_PER_ADDRESS=1         # sponsored names per wallet
SPONSOR_PER_DAY=200           # ceiling across everyone; gas is real money
SPONSOR_LEDGER=data/sponsored.json

# ── Spend budgets ────────────────────────────────────────────────────────────
# Denominated in ETH, not operations: counting operations does not bound cost,
# because gas price is not in the count. Both endpoints refuse above the gas
# ceiling rather than paying whatever the market asks.
SPONSOR_PER_ADDRESS_ETH=0.001
SPONSOR_PER_DAY_ETH=0.1
SPONSOR_PER_ADDRESS_OPS=1
SPONSOR_MAX_GAS_GWEI=50
# The relay is a repeated service for the same person, so its per-address
# allowance is larger — but it is global-only until the depositor can be read
# out of the attestation (see relay.ts).
RELAY_PER_DAY_ETH=0.1
RELAY_MAX_GAS_GWEI=50
RELAY_LEDGER=data/relay-budget.json
